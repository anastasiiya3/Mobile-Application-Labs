rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
 function admin() { return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
 match /books/{id} { allow read: if true; allow write: if admin(); }
 match /users/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
} }
